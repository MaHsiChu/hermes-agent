remote.example.invalid {
    encode zstd gzip
    @snapshot path /api/remote/bridge/snapshot
    @regular not path /api/remote/bridge/snapshot
    request_body @snapshot {
        max_size 65MB
    }
    request_body @regular {
        max_size 9MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
    reverse_proxy relay:8787
}
identity.example.invalid {
    reverse_proxy keycloak:8080
}
